<?xml version="1.0" encoding="utf-8" ?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF00CC"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

<!--        การ์ดหลัก-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFF00"
            android:padding="20dp"
            android:orientation="vertical"
            android:gravity="center_horizontal">

<!--            หัวข้อแอปป-->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="บันทึกค่าใช้จ่ายประจำวัน"
                android:textSize="22dp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:layout_marginBottom="4dp"
                android:gravity="center"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="จดทุกบาทที่ใช้วันนี้ให้ครบ"
                android:textSize="14dp"
                android:textColor="#FF1493"
                android:layout_marginBottom="16dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ใส่จำนวนเงินมา เป็นบาท"
                android:textColor="#3300CC"
                android:textSize="14dp"/>

            <EditText
                android:id="@+id/etAmount"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@color/design_default_color_secondary_variant"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:inputType="numberDecimal"
                android:hint=" เช่น 100 หรือ 10.25"
                android:textColor="@color/design_default_color_on_primary"
                android:textColorHint="@color/design_default_color_on_primary"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"/>


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="คำอธิบาย"
                android:textColor="#CC0000"
                android:textSize="14dp"/>

            <EditText
                android:id="@+id/etNote"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@color/design_default_color_on_primary"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:inputType="text"
                android:hint="เช่น กลางวัน ค่าเดินทาง"
                android:textColor="#C71585"
                android:textColorHint="@color/design_default_color_secondary"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end">


                <Button
                    android:id="@+id/btnClear"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="เคลียร์"
                    android:textAllCaps="false"
                    android:backgroundTint="@color/design_default_color_secondary"
                    android:textColor="#CC0000"
                    android:layout_marginEnd="8dp"/>
                <Button
                    android:id="@+id/btnAdd"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="เพิ่มรายการ"
                    android:textAllCaps="false"
                    android:backgroundTint="@color/design_default_color_secondary"
                    android:textColor="#FF0099"
                    />

            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#FF1493"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="12dp"/>
            <TextView
                android:id="@+id/tvLastItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="รายการล่าสุด"
                android:textColor="#006400"
                android:layout_marginTop="4dp"/>
            <TextView
                android:id="@+id/tvTotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ยอดรวม"
                android:textStyle="bold"
                android:textSize="16dp"
                android:textColor="#CC0000"
                android:layout_marginTop="8dp"/>

        </LinearLayout>

    </LinearLayout>



</ScrollView>